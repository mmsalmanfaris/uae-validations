{
  "name": "uae-validations",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript validators for UAE identifiers, phone numbers, IBANs, and tax numbers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./emirates-id": { "types": "./dist/emirates-id/index.d.ts", "import": "./dist/emirates-id/index.js", "require": "./dist/emirates-id/index.cjs" },
    "./phone": { "types": "./dist/phone/index.d.ts", "import": "./dist/phone/index.js", "require": "./dist/phone/index.cjs" },
    "./iban": { "types": "./dist/iban/index.d.ts", "import": "./dist/iban/index.js", "require": "./dist/iban/index.cjs" },
    "./tax": { "types": "./dist/tax/index.d.ts", "import": "./dist/tax/index.js", "require": "./dist/tax/index.cjs" },
    "./administrative": { "types": "./dist/administrative/index.d.ts", "import": "./dist/administrative/index.js", "require": "./dist/administrative/index.cjs" },
    "./address": { "types": "./dist/address/index.d.ts", "import": "./dist/address/index.js", "require": "./dist/address/index.cjs" },
    "./currency": { "types": "./dist/currency/index.d.ts", "import": "./dist/currency/index.js", "require": "./dist/currency/index.cjs" },
    "./privacy": { "types": "./dist/privacy/index.d.ts", "import": "./dist/privacy/index.js", "require": "./dist/privacy/index.cjs" },
    "./schema": { "types": "./dist/schema/index.d.ts", "import": "./dist/schema/index.js", "require": "./dist/schema/index.cjs" },
    "./i18n": { "types": "./dist/i18n/index.d.ts", "import": "./dist/i18n/index.js", "require": "./dist/i18n/index.cjs" },
    "./dates": { "types": "./dist/dates/index.d.ts", "import": "./dist/dates/index.js", "require": "./dist/dates/index.cjs" },
    "./metadata": { "types": "./dist/metadata/index.d.ts", "import": "./dist/metadata/index.js", "require": "./dist/metadata/index.cjs" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
